{
  "section": "section-25-differentiability-of-convex-functions",
  "source_span": "printed pages 241-250; PDF pages 259-268.",
  "purpose": "Deck-local numerical probes for distinguishing differentiability from nonsmooth convex behavior.",
  "finite_difference_step": 0.0001,
  "probes": [
    {
      "name": "smooth quadratic bowl",
      "function": "f(x1,x2)=x1^2+2*x2^2",
      "point": [0.6, -0.4],
      "analytic_gradient": [1.2, -1.6],
      "central_difference_gradient": [1.2, -1.6],
      "residual_norm": 0.0,
      "subdifferential_description": "singleton {grad f(x)}",
      "differentiable": true
    },
    {
      "name": "absolute value corner",
      "function": "f(t)=abs(t)",
      "point": [0.0],
      "left_slope": -1.0,
      "right_slope": 1.0,
      "central_difference": 0.0,
      "subdifferential_description": "interval [-1,1]",
      "differentiable": false,
      "reason": "one-sided directional slopes do not collapse to one linear derivative"
    },
    {
      "name": "max ridge",
      "function": "f(x1,x2)=max(x1,x2)",
      "point": [0.5, 0.5],
      "active_gradients": [[1.0, 0.0], [0.0, 1.0]],
      "subdifferential_description": "convex hull of the active gradients",
      "directional_checks": [
        {"direction": [1.0, 0.0], "directional_derivative": 1.0},
        {"direction": [0.0, 1.0], "directional_derivative": 1.0},
        {"direction": [1.0, -1.0], "directional_derivative": 1.0},
        {"direction": [-1.0, 1.0], "directional_derivative": 1.0}
      ],
      "differentiable": false,
      "reason": "two active affine pieces expose a segment of valid subgradients"
    }
  ],
  "rule_checks": {
    "singleton_subdifferential_equivalence": true,
    "directional_derivative_linear_when_differentiable": true,
    "finite_open_convex_differentiable_implies_c1": true,
    "gradient_continuity_on_differentiability_set": true
  }
}
